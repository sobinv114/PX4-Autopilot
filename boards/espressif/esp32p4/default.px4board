CONFIG_BOARD_TOOLCHAIN="riscv-none-elf"
CONFIG_BOARD_ARCHITECTURE="esp32p4"
CONFIG_BOARD_CONSTRAINED_MEMORY=y

#
# Serial Port Assignments
#
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS1"
# PX4I0="/dev/ttyS4"
CONFIG_BOARD_SERIAL_TEL2="/dev/ttyS0"
CONFIG_BOARD_SERIAL_TEL3="/dev/ttyS5"
CONFIG_BOARD_SERIAL_GPS1="/dev/ttyS2"
CONFIG_BOARD_SERIAL_RC="/dev/ttyS3"

#
# ADC & Power Drivers
#
CONFIG_DRIVERS_ADC_BOARD_ADC=y
CONFIG_DRIVERS_BATT_SMBUS=y
CONFIG_DRIVERS_SMART_BATTERY_IP5109=y

#
# Barometers (SPI & I2C)
#
CONFIG_DRIVERS_BAROMETER_BMP388=y
CONFIG_DRIVERS_BAROMETER_BMP280=y
CONFIG_DRIVERS_BAROMETER_GOERTEK_SPL06=y
CONFIG_DRIVERS_BAROMETER_MS5611=y

#
# Differential Pressure & Distance
#
CONFIG_COMMON_DIFFERENTIAL_PRESSURE=y
CONFIG_COMMON_DISTANCE_SENSOR=y
CONFIG_COMMON_OPTICAL_FLOW=y

#
# GNSS / GPS
#
CONFIG_DRIVERS_GPS=y
CONFIG_EXAMPLES_FAKE_GPS=y
CONFIG_EXAMPLES_FAKE_IMU=y
#
# IMU Sensors (InvenSense on SPI2 & SPI3)
#
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20602=y
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42670P=y
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42605=y
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42688P=y

#
# Magnetometers (Compass on I2C0 & I2C1)
#
CONFIG_DRIVERS_MAGNETOMETER_ISENTEK_IST8310=y
CONFIG_DRIVERS_MAGNETOMETER_AKM_AK8963=y
CONFIG_DRIVERS_MAGNETOMETER_HMC5883=y
CONFIG_DRIVERS_MAGNETOMETER_QMC5883L=y

#
# Actuators, RC Input & PWM
#
CONFIG_DRIVERS_PWM_OUT=y
CONFIG_DRIVERS_RC_INPUT=y
CONFIG_DRIVERS_RC_CRSF_RC=y
CONFIG_EXAMPLES_ESP_SBUS_INV_CTRL=y
CONFIG_DRIVERS_HEATER=n
CONFIG_DRIVERS_LIGHTS_RGBLED=y

#
# Telemetry & Logging
#
CONFIG_COMMON_TELEMETRY=y
CONFIG_MODULES_LOGGER=y
CONFIG_LOGGER_STACK_SIZE=5200

#
# Core PX4 Modules & Flight Controls
#
CONFIG_MODULES_AIRSPEED_SELECTOR=y
CONFIG_MODULES_ATTITUDE_ESTIMATOR_Q=y
CONFIG_MODULES_BATTERY_STATUS=y
CONFIG_MODULES_CAMERA_FEEDBACK=y
CONFIG_MODULES_COMMANDER=y
CONFIG_MODULES_CONTROL_ALLOCATOR=y
CONFIG_MODULES_DATAMAN=y
CONFIG_MODULES_EKF2=y
CONFIG_MODULES_EVENTS=y
CONFIG_MODULES_FLIGHT_MODE_MANAGER=y
CONFIG_MODULES_FW_ATT_CONTROL=y
CONFIG_MODULES_FW_AUTOTUNE_ATTITUDE_CONTROL=y
CONFIG_MODULES_FW_POS_CONTROL=y
CONFIG_MODULES_FW_RATE_CONTROL=y
CONFIG_MODULES_GIMBAL=y
CONFIG_MODULES_GYRO_CALIBRATION=y
CONFIG_MODULES_GYRO_FFT=y
CONFIG_MODULES_LAND_DETECTOR=y
CONFIG_MODULES_LANDING_TARGET_ESTIMATOR=y
CONFIG_MODULES_LOCAL_POSITION_ESTIMATOR=y
CONFIG_MODULES_MAG_BIAS_ESTIMATOR=y
CONFIG_MODULES_MANUAL_CONTROL=y
CONFIG_MODULES_MAVLINK=y
CONFIG_MODULES_MC_ATT_CONTROL=y
CONFIG_MODULES_MC_AUTOTUNE_ATTITUDE_CONTROL=y
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=y
CONFIG_MODULES_MC_POS_CONTROL=y
CONFIG_MODULES_MC_RATE_CONTROL=y
CONFIG_MODULES_NAVIGATOR=y
CONFIG_MODE_NAVIGATOR_VTOL_TAKEOFF=y
CONFIG_MODULES_RC_UPDATE=y
CONFIG_MODULES_ROVER_POS_CONTROL=y
CONFIG_MODULES_SENSORS=y
CONFIG_MODULES_VTOL_ATT_CONTROL=y

#
# PX4 System Commands & Utilities
#
CONFIG_SYSTEMCMDS_ACTUATOR_TEST=y
CONFIG_SYSTEMCMDS_I2CDETECT=y
CONFIG_SYSTEMCMDS_LED_CONTROL=y
CONFIG_SYSTEMCMDS_MFT=y
CONFIG_SYSTEMCMDS_MTD=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_PERF=y
CONFIG_SYSTEMCMDS_REBOOT=y
CONFIG_SYSTEMCMDS_SYSTEM_TIME=y
CONFIG_SYSTEMCMDS_USB_CONNECTED=y
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=y
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_TOP=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
CONFIG_DRIVERS_DSHOT=y
CONFIG_DRIVERS_TONE_ALARM=y
CONFIG_DRIVERS_LIGHTS_RGBLED_NCP5623C=y
CONFIG_MODULES_LOAD_MON=y
CONFIG_SYSTEMCMDS_TUNE_CONTROL=y
CONFIG_DRIVERS_LIGHTS_RGBLED_LP5562=y
CONFIG_DRIVERS_LIGHTS_RGBLED_IS31FL3195=y
CONFIG_MODULES_PAYLOAD_DELIVERER=y
CONFIG_SYSTEMCMDS_BSONDUMP=y
CONFIG_MODULES_HARDFAULT_STREAM=y
CONFIG_COMMON_RC=y
CONFIG_NUM_MISSION_ITEMS_SUPPORTED=1000
CONFIG_MODULES_FW_LATERAL_LONGITUDINAL_CONTROL=y
CONFIG_MODULES_FW_MODE_MANAGER=y
CONFIG_SYSTEMCMDS_DMESG=y
CONFIG_SYSTEMCMDS_GPIO=y
CONFIG_SYSTEMCMDS_HARDFAULT_LOG=y
CONFIG_SYSTEM_SYSTEM=y
CONFIG_SYSTEM_SPITOOL=y
CONFIG_SYSTEM_I2CTOOL=y
CONFIG_SYSTEMCMDS_I2C_LAUNCHER=y

CONFIG_MODULES_NAVIGATOR_STACKSIZE=8192
CONFIG_MODULES_DATAMAN_STACKSIZE=6144
CONFIG_DRIVERS_GPS_STACKSIZE=4096
CONFIG_MODULES_MAVLINK_STACKSIZE=6144

CONFIG_DRIVERS_UAVCAN=y
#CONFIG_MODULES_DRONECAN=y
#CONFIG_DRIVERS_CANARD=y
CONFIG_DRIVERS_LIGHTS_NEOPIXEL=y

CONFIG_DRIVERS_PX4IO=y
CONFIG_DRIVERS_SAFETY_BUTTON=y
CONFIG_DRIVERS_ADC_ADS1115=y
CONFIG_DRIVERS_ADC_TLA2528=y
CONFIG_DRIVERS_PCA9685_PWM_OUT=y
CONFIG_DRIVERS_POWER_MONITOR_INA226=y
CONFIG_DRIVERS_POWER_MONITOR_INA228=y
CONFIG_DRIVERS_POWER_MONITOR_INA238=y
CONFIG_DRIVERS_GNSS_SEPTENTRIO=y
CONFIG_SYSTEMCMDS_IO_BYPASS_CONTROL=y
CONFIG_DRIVERS_PWM_INPUT_ESP32=y
CONFIG_DRIVERS_TEMPERATURE_SENSOR_AHT10=y
