#!/bin/sh
#
# PX4 FMUv4 specific board sensors init
#------------------------------------------------------------------------------

# ============================================
# Power Monitor Detection
# ============================================
set HAVE_PM2 yes
set HAVE_PM3 yes
set INA_CONFIGURED no

# Optional: Disable PM2/PM3 if hardware does not have them
# if mft query -q -k MFT -s MFT_PM2 -v 0
# then
# 	set HAVE_PM2 no
# 	set HAVE_PM3 no
# fi

# ============================================
# Magnetometer
# ============================================
if param compare -s SYS_HAS_MAG 1
then
	hmc5883 start -I -b 1
fi

# ============================================
# Barometer
# ============================================
if param compare -s SYS_HAS_BARO 1
then
	bmp180 start -I -b 1 -a 0x77
fi

# ============================================
# External ADCs
# ============================================
if param compare -s ADC_ADS1115_EN 1
then
	ads1115 start -I -b 1 -a 0x48
	board_adc start -n
else
	board_adc start
fi

if param compare -s ADC_TLA2528_EN 1
then
	tla2528 start -X
fi

# PCA9685 PWM Expander
if param greater PCA9685_EN_BUS 1
then
	pca9685_pwm_out start -I -b 2 -a 0x40
fi

# ============================================
# Digital Power Monitors (INA226 / INA228 / INA238)
# ============================================

# INA226
if param compare SENS_EN_INA226 1
then
	ina226 -X -b 1 -t 1 -k start

	if [ $HAVE_PM2 = yes ]
	then
		ina226 -X -b 2 -t 2 -k start
	fi

	if [ $HAVE_PM3 = yes ]
	then
		ina226 -X -b 3 -t 3 -k start
	fi

	set INA_CONFIGURED yes
fi

# INA228
if param compare SENS_EN_INA228 1
then
	ina228 -X -b 1 -t 1 -k start

	if [ $HAVE_PM2 = yes ]
	then
		ina228 -X -b 2 -t 2 -k start
	fi

	if [ $HAVE_PM3 = yes ]
	then
		ina228 -X -b 3 -t 3 -k start
	fi

	set INA_CONFIGURED yes
fi

# INA238
if param compare SENS_EN_INA238 1
then
	ina238 -X -b 1 -t 1 -k start

	if [ $HAVE_PM2 = yes ]
	then
		ina238 -X -b 2 -t 2 -k start
	fi

	if [ $HAVE_PM3 = yes ]
	then
		ina238 -X -b 3 -t 3 -k start
	fi

	set INA_CONFIGURED yes
fi

# Auto-detect INA if none was enabled manually
if [ $INA_CONFIGURED = no ]
then
	i2c_launcher start -b 1 -t 1

	if [ $HAVE_PM2 = yes ]
	then
		i2c_launcher start -b 2 -t 2
	fi

	if [ $HAVE_PM3 = yes ]
	then
		i2c_launcher start -b 3 -t 3
	fi
fi



# ASAIR AHT10 temperature/humidity sensor (internal I2C bus 1, addr 0x38)
if param compare -s SENS_EN_AHT10 1
then
	# aht10 start -I -b 1
	aht10 start -I -b 1 -a 0x38
fi


# ============================================
# IMU Initialization
# ============================================

# Give IMU hardware time to stabilize after power-on
usleep 300000

set IMU_FOUND no

# 1. Try MPU6500
if mpu6500 -s -b 2 start
then
	set IMU_FOUND yes
fi

# 2. Try ICM42688P
if [ $IMU_FOUND = no ]
then
	if icm42688p -s -b 2 -R 2 start
	then
		set IMU_FOUND yes
	fi
fi

# 3. Try ICM42605
if [ $IMU_FOUND = no ]
then
	if icm42605 -s -b 2 -R 2 start
	then
		set IMU_FOUND yes
	fi
fi

# 4. Try ICM20602
if [ $IMU_FOUND = no ]
then
	if icm20602 -s -b 2 -R 2 start
	then
		set IMU_FOUND yes
	fi
fi

# 5. Try ICM42670P
if [ $IMU_FOUND = no ]
then
	if icm42670p -s -b 2 -R 2 start
	then
		set IMU_FOUND yes
	fi
fi

# Final status check
if [ $IMU_FOUND = no ]
then
	echo "ERROR: No IMU detected on SPI bus!"
else
	echo "IMU successfully started"
fi

